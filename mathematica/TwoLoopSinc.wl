(* ---------------- v2_00: one-loop vertex + Pi2 (hand-translated from kernels/g2/v2_00.c) ---------------- *)
(* ptv200b: the one-loop vertex with electron lines y0, y1, photon y2, and the extra term vx added to V
   (the loop's contribution); ptv200 subtracts the Pi2 charge renormalisation pointwise: the loop with lines
   a, b enters as  om (F[photon + a b/(a+b)] - F[photon]),  om = -2 a b/(a+b)^4,  vx = a + b.
   The factor -4 matches norm = 1/256 to the kernel's own -1/64; the 1/(x2 + x4) is the Jacobian of
   splitting the photon in two.  Homogeneous of degree -6 in x0..x5, like the other kernels. *)
ptv200b[y0_, y1_, y2_, vx_, pw_] := Module[{U, V, cp0, cp1, cpp0, cpp1, T},
  U = y0 + y1 + y2;
  V = (y0 + y1)^2/U;
  cp0 = (y1 + y2)/U; cpp0 = -y1/U; cp1 = -y0/U; cpp1 = (y0 + y2)/U;
  T = cp0 + cp1 (1 - cp0) + cpp0 + cpp1 (1 - 2 cp0 - cpp0);
  -64 T/U^2 pw[V + vx, 1]];
ptv200[x0_, x1_, x2_, x3_, x4_, x5_, pw_] := Module[{a = x3, b = x5, S, c, om, ph = x2 + x4},
  S = a + b; c = a b/S; om = -2 a b/S^4;
  -4 om (ptv200b[x0, x1, ph + c, S, pw] - ptv200b[x0, x1, ph, S, pw])/ph];

(* ---------------- the graphs ---------------- *)
graphs = {"g2_00", "g2_01", "g2_02", "g2_03", "v2_00"};
kernel = <|"g2_00" -> ptg200, "g2_01" -> ptg201, "g2_02" -> ptg202, "g2_03" -> ptg203, "v2_00" -> ptv200|>;
mirror = <|"g2_00" -> 2, "g2_01" -> 2, "g2_02" -> 1, "g2_03" -> 1, "v2_00" -> 1|>;
volkov = <|"g2_00" -> "2; 1-4, 3-5", "g2_01" -> "2; 1-5, 3-4", "g2_02" -> "3; 1-4, 2-5", "g2_03" -> "3; 1-5, 2-4",
  "v2_00" -> "2; 1-3 + Pi2"|>;
(* exact values in Volkov's scheme, mirror weight included (closed forms; also in driver/graphs.c) *)
exactForm = <|
  "g2_00" -> -55/24 + Pi^2/18 + Pi^2 Log[2]/3 - Zeta[3]/2,
  "g2_01" -> -1/24 - Pi^2/18,
  "g2_02" -> 1/6 + 13 Pi^2/36 - 5 Pi^2 Log[2]/6 + 5 Zeta[3]/4,
  "g2_03" -> 11/48 + Pi^2/18,
  "v2_00" -> 119/36 - Pi^2/3|>;
exact = N[exactForm, 16];
a2Exact = N[197/144 + Pi^2/12 - Pi^2 Log[2]/2 + 3 Zeta[3]/4, 16];   (* A_1^(4): all seven diagrams = Total[exact] *)
norm = 1/256;                   (* overall normalisation of the generated kernels *)

dims = <|"All" -> (6 &), "Delta" -> (5 &), "DeltaGL" -> (If[MemberQ[{"g2_01", "g2_03", "v2_00"}, #], 3, 4] &)|>;
dim[form_String, g_String] := dims[form][g];

(* ---------------- integrands in the summation variables s ---------------- *)
(* All: s = {x0, x1, x2, x3, x4, x5} *)
fAll[g_String][s_List] := norm kernel[g] @@ Append[s, schwPW];
(* Delta: s = {x0, x1, x2, x3, x5}, x4 = 1 *)
fDelta[g_String][{x0_, x1_, x2_, x3_, x5_}] := norm kernel[g][x0, x1, x2, x3, 1, x5, projPW];

(* DeltaGL: the external-vertex pair (sa, sb) = (sigma u, sigma (1-u)), Jacobian sigma.
   splitArgs[g][sigma, u, s] -> {Jacobian factor beyond sigma, {x0,...,x5}}                       *)
splitArgs["g2_00"][sig_, u_, {s2_, s3_, s5_}] := {1, {sig u, sig (1 - u), s2, s3, 1, s5}};
splitArgs["g2_02"][sig_, u_, {s0_, s3_, s5_}] := {1, {s0, sig u, sig (1 - u), s3, 1, s5}};
(* g2_03: the segments x0 (1-2) and x3 (4-5) carry the same loop momentum on either side of the external vertex
   and enter only as t = x0 + x3; as in the C, x0 = x3 = t/2 with Jacobian t. *)
splitArgs["g2_03"][sig_, u_, {t_, s5_}] := {t, {t/2, sig u, sig (1 - u), t/2, 1, s5}};
(* g2_01: the lines x1 and x3 either side of the self-energy enter only as t = x1 + x3, and
   Int dx1 dx3 F(x1 + x3) = Int dt t F(t); the pair at the external vertex is (x0, t). *)
splitArgs["g2_01"][sig_, u_, {s2_, s5_}] := {sig (1 - u), {sig u, sig (1 - u)/2, s2, sig (1 - u)/2, 1, s5}};
(* v2_00: (x0, x1) = (sigma u, sigma (1-u)); Cheng-Wu on the whole photon, x2 + x4 = 1 (so the 1/(x2 + x4)
   Jacobian is 1), and the loop lines a, b summed. *)
splitArgs["v2_00"][sig_, u_, {a_, b_}] := {1, {sig u, sig (1 - u), 1/2, a, 1/2, b}};

(* The u rule.  With the extra weight a[[1]] of splitArgs, the integrand is linear in u, so one node at the
   weighted mean is exact (the C kernels' rule, tools/glpts.py): u = 1/2 with weight 1, and for g2_01, whose
   weight is (1 - u), u = 1/3 with weight 3/4.  fDeltaGL[g, n] uses n-point Gauss-Legendre instead, to check. *)
uRule = <|"g2_00" -> {{1/2}, {1}}, "g2_01" -> {{1/3}, {3/4}}, "g2_02" -> {{1/2}, {1}}, "g2_03" -> {{1/2}, {1}},
  "v2_00" -> {{1/2}, {1}}|>;
glRule[2] = {{1/2 - Sqrt[3]/6, 1/2 + Sqrt[3]/6}, {1/2, 1/2}};
glRule[3] = {{1/2 - Sqrt[15]/10, 1/2, 1/2 + Sqrt[15]/10}, {5/18, 4/9, 5/18}};
glRule[n_Integer] := glRule[n] = Module[{t, r},
  r = SortBy[t /. Solve[LegendreP[n, t] == 0, t], N];
  {(1 + r)/2, Function[x, 1/((1 - x^2) (D[LegendreP[n, t], t] /. t -> x)^2)] /@ r}];

fDeltaGL[g_String, ngl_: Automatic][s_List] := Module[{sig = First[s], rest = Rest[s], xu, wu, a, acc = 0},
  {xu, wu} = If[ngl === Automatic, uRule[g], glRule[ngl]];
  Do[a = splitArgs[g][sig, xu[[i]], rest];
     acc = acc + wu[[i]] a[[1]] kernel[g] @@ Append[a[[2]], projPW], {i, Length[xu]}];
  norm sig acc];

integrand[form_String, g_String] := Switch[form, "All", fAll[g], "Delta", fDelta[g], "DeltaGL", fDeltaGL[g]];

(* ---------------- the general term and the Sinc sum ---------------- *)
(* sincTerm[form, g, k, h]: the term of the D-fold Sinc sum at lattice node k (a list of D integers,
   or symbols for the general term).  z = h k, s = Exp[z], weight h^D Exp[Total[z]]. *)
sincTerm::dim = "`1` form of `2` sums over `3` variables, but the node has `4` entries.";
sincTerm[form_String, g_String, k_List, h_] /; Length[k] =!= dim[form, g] :=
  (Message[sincTerm::dim, form, g, dim[form, g], Length[k]]; $Failed);
sincTerm[form_String, g_String, k_List, h_] := Module[{z = h k},
  h^Length[k] Exp[Total[z]] integrand[form, g][Exp[z]]];

(* sincSum[form, g, h, K]: the full box |k_i| <= K, (2K+1)^D terms.  Keep K small (or use the
   C code); the Sinc sum converges as Exp[-c/h] once the box is wide enough. *)
sincSum[form_String, g_String, h_, K_Integer] := Module[{d = dim[form, g], f = integrand[form, g], tot = 0},
  Scan[(tot += h^d Exp[Total[h #]] f[Exp[h #]]) &, Tuples[Range[-K, K], d]];
  tot];
